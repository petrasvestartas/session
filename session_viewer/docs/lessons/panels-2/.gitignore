dist/
__pycache__/

# Keep runtime inputs tracked: assets/view_local.yaml, assets/text/ fonts and license,
# text-quality.html, and the explicit regression PB below. Local working datasets stay
# on disk as an ignored cache; named remote scenes resolve through app/route.rs.
# Ignore contents, not the directory, so the required .gitkeep and fixture can be included.
assets/pb/*
!assets/pb/.gitkeep
!assets/pb/view_mixed_teapot.pb

# The browser application and tutorials share a reproducible dependency resolution.
!Cargo.lock

# Course tooling scratch at the repo root: `course_pages.py` replays the series into a
# disposable workspace and keeps every step's text beside it. Regenerable, and large - the
# snapshots alone are hundreds of megabytes.
workspace/
logs/
snapshots/
