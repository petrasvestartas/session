diff --git a/session_viewer/src/engine/gpu/instance.rs b/session_viewer/src/engine/gpu/instance.rs
new file mode 100644
index 0000000000000000000000000000000000000000..0c995d023dd48ab3876adcd34817a33b3adc7a98
