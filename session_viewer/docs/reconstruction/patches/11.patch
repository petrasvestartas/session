+            "the maximum-radius corner exposes the original solid"
+        );
+        input.view_proj.m[12] = 0.25;
+        let moved = gpu.render_offscreen(&input);
+        assert_ne!(
+            pixels, moved,
+            "the nameplate follows its projected source center"
+        );
+        assert_eq!(
