+                false,
+                1,
+                &[Point::new(a[0], a[1], 0.0), Point::new(z[0], z[1], 0.0)],
+            );
+            let pcurve_index = b.add_curve_2d(&pcurve);
+            b.add_pcurve(edge, surface_index, pcurve_index as i32, -1);
+            edges.push(BRepRef::new(edge as i32, BRepOrientation::Forward));
