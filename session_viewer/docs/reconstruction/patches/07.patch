+            let z = corners[(side + 1) % 4];
+            let direction = if a[0] != z[0] { 0 } else { 1 };
+            let mut curve = surface.iso_curve(direction, a[1 - direction]).unwrap();
+            assert!(curve.trim(0.1, 0.9));
