+
+/// Order an isoparametric chain by parameter, breaking ties with its stable vertex key.
+fn parameter_order(a: &(f64, usize), b: &(f64, usize)) -> std::cmp::Ordering {
+    sample_order(&a.0, &b.0).then(a.1.cmp(&b.1))
