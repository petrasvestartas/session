diff --git a/session_viewer/examples/interaction_fixture.rs b/session_viewer/examples/interaction_fixture.rs
new file mode 100644
index 0000000000000000000000000000000000000000..584ace230675c381398b436ded18cf300c83c8af
--- /dev/null
