+    let proj_y = 1.0 / 30.0_f64.to_radians().tan() * 0.001;
+    for (w, h) in [(vp_w, vp_h), (1280.0, 720.0), (1920.0, 1080.0)] {
+        let f = fit(&lo, &hi, w / h);
