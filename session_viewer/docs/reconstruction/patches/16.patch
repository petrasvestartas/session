+    let (lo, hi) = scene_box(&s, &world, &plates, &outlines);
+    let mut f0 = fit(&lo, &hi, vp_w / vp_h);
+    if let Ok(e) = std::env::var("CENSUS_EYE") {
+        let v: Vec<f64> = e.split(',').filter_map(|t| t.trim().parse().ok()).collect();
+        if v.len() == 3 {
+            let centre = [
+                (lo[0] + hi[0]) * 0.0005,
+                (lo[1] + hi[1]) * 0.0005,
+                (lo[2] + hi[2]) * 0.0005,
