+    v.clear();
+    for p in &plates {
+        v.push(p.diag);
+    }
+    stats("diagonal mm", &mut v);
+    v.clear();
+    for p in &plates {
+        v.push(p.diag / p.ext[0].max(1e-9));
+    }
+    stats("diagonal / thickness(AABB)", &mut v);
+    v.clear();
+    for p in &plates {
+        v.push(p.diag / p.t_real.max(1e-9));
+    }
+    stats("diagonal / thickness(real)", &mut v);
+    let mut flat = 0;
+    let mut rotated = 0;
+    let mut tris = 0;
+    for p in &plates {
