+    let size = vec2<i32>(textureDimensions(coarse_mask));
+    let c = p / POOL;
+    for (var y = -1; y <= 1; y++) {
+        for (var x = -1; x <= 1; x++) {
+            let q = c + vec2<i32>(x, y);
+            if (any(q < vec2<i32>(0)) || any(q >= size)) { continue; }
+            if (textureLoad(coarse_mask, q, 0).r > 0.0) { return true; }
+        }
+    }
