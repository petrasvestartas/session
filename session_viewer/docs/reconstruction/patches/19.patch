+
+/// The slice loop behind `spawn_sheet_rest`.
+async fn sheet_rest(c: SheetCursor) {
+    let (url, idx, fields) = (c.url, c.idx, c.fields);
+    let generation = GENERATION.get();
+    let mut at = c.from;
