+pub fn field_at(header: &[u8], at: u64, end: u64) -> Option<Field> {
+    let (tag, used) = varint(header, 0)?;
+    let (field, wire) = (u32::try_from(tag >> 3).ok()?, (tag & 7) as u32);
+    if field == 0 {
