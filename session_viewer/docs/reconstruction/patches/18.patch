-struct PhysicalColor {
-    @location(0) color: vec4<f32>,
-    @location(1) gradient: vec2<f32>,
-};
-struct PhysicalId {
- @location(0) id: vec2<u32>,
- @location(1) gradient: vec2<f32>,
-};
-fn physical_gradient(depth: f32) -> vec2<f32> {
-    let scaled = vec2<f32>(dpdx(depth), dpdy(depth)) * PLANE_SCALE;
