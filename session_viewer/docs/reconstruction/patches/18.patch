+struct ProjectedPolygon {
+    points: array<vec3<f32>,
+    4>,
+    count: u32,
+};
+
+fn physical_clip_corner(index: u32) -> vec4<f32> {
+    let vertex = physical_indices[index];
+    let base = vertex * 10u;
