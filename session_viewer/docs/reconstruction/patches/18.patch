index 0000000000000000000000000000000000000000..635ab65339a6f2c7ff3472f265f1c6edf4ff68e4
--- /dev/null
+++ b/session_viewer/src/shaders/scan_triangle_tiles.wgsl
@@ -0,0 +1,120 @@
+struct ScanLine {
+    thickness: f32,
+    proj_y: f32,
+    ortho_h: f32,
+    vp_h: f32,
+    vp_w: f32,
+};
