+            polygon.count++;
+        }
+
+        if (distance >= 0.0) {
+            clipped[polygon.count] = current;
+            polygon.count++;
+        }
+
+        previous = current;
+        previous_distance = distance;
+    }
+
+    for (var i = 0u; i<polygon.count; i++) {
+        let clip = clipped[i];
+
+        if (clip.w <= 0.0) {
+            polygon.count = 0u;
+            return polygon;
+        }
