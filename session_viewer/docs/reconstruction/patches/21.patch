+        // the command line goes through, or the object jumps to a different place than the last
+        // preview frame drew it.
+        let delta = Xform::from_matrix(delta);
+        let Some(local) = self
+            .scene
+            .local_for_world_delta(active.row, &delta, &active.base_local)
