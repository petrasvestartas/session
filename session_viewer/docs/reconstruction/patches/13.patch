+/// A packed `int32` (varint) array in full.
+pub fn packed_i32(raw: &[u8]) -> Vec<i32> {
+    let mut out = Vec::new();
+    let mut i = 0usize;
+    while i < raw.len() {
+        let Some((v, n)) = varint(raw, i) else { break };
+        out.push(v as i32);
+        i += n;
+    }
+    out
