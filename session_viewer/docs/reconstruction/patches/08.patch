+    /// The walked tables of one BRep at row 5: arena rows, pipes, ribbons, markers, flags.
+    fn walked(b: &BRep) -> (ArenaRows, SegRows, GlyphRows, Row) {
+        let mut arena = ArenaRows::default();
+        let mut seg = SegRows::default();
