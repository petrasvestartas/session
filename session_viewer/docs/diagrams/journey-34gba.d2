vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
page: "Page metadata owner: two listeners + allocation token"
cached: "Cached hide/show: pause/resume timer; retain outcome"
final: "Final exit: persist close; defer matching-owner disposal"
gpu: "GPU loss: eighteen drawing/input listeners stop"
page -> cached
page -> final
gpu -> page: "metadata remains available"
