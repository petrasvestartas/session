vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down

A: "surface domain\n+ outer loop + inner loops" { class: box }
B: "triangles inside the allowed region" { class: box }
C: "trimmed 3D face + chains" { class: box }
D: "arena rows + pipes" { class: box }
E: "pipe_ids: u-min / u-max / v-min / v-max" { class: box }

A -> B: "constrained UV triangulation" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
B -> C: "lift with boundary XYZ" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
C -> D: "walk_surface" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
D -> E: "map_surface_boundaries" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
