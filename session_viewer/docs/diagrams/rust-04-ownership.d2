vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down
owner: "main owns Vec [4, 8]" { class: box }
borrow: "append(&mut values, 12)\ntemporary exclusive access" { class: focus }
back: "main owns Vec [4, 8, 12]" { class: box }
move: "consume(values) owns the Vec\nmain cannot use values again" { class: focus }

owner -> borrow: "lend" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
borrow -> back: "borrow ends" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
back -> move: "move ownership" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
