vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Observe old imported/history owners through Weak"
n1: "Close clears source and document roots"
n2: "Empty GPU synchronization drops remaining displays"
n3: "Reject late reads and reopen with fresh IDs"
n0 -> n1 -> n2 -> n3
