vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down
indices: "Indices: 0, 1, 2 | 0, 2, 3" {class: focus}
positions: "Positions: left, bottom, right, top" {class: box}
lower: "Triangle 1\nleft → bottom → right" {class: box}
upper: "Triangle 2\nleft → right → top" {class: box}
indices -> positions: "look up"
positions -> lower
positions -> upper
