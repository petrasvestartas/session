vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Retained curve row and original source"
b: "Enabled control index and document parent ID"
c: "Exact original control and accepted placement"
d: "Six-pixel marker display bytes"
e: "Shared change-only marker lane"
f: "Hide / Close release actual control buffer"
a -> b
b -> c
c -> d
d -> e
e -> f
