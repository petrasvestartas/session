vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box: { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down
setup: "Browser: bounded setup" {class: box}
image: "Browser: surface image" {class: box}
renderer: "Renderer: record and submit" {class: focus}
present: "Browser: present" {class: box}
setup -> image
image -> renderer: "TextureView"
renderer -> present
