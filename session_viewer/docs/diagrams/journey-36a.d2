vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Shared checked display points"
b: "One nonzero span per adjacent pair"
c: "Previous and next points"
d: "Closed path wraps; open path carries end heads"
e: "72-byte packed connected record"
a -> b
b -> c
c -> d
d -> e
