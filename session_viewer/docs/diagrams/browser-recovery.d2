vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box: { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 16; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 16; font-color: "#111111" } }
}
direction: down
running: "Page running\nSave startup + heartbeat" {class: box}
error: "GPU error callback\nSave first failure" {class: focus}
stop: "Stop GPU work\nNo uploads, resize or drawing" {class: box}
reload: "Device lost? Reload once\nDPR 1, antialiasing off" {class: box}
report: "Download viewer JSON\nNow or after reopening" {class: focus}
crash: "Browser process dies\nPage code cannot run" {class: box}
native: "Firefox about:crashes\nNative crash report" {class: box}
running -> error -> stop -> reload -> report
running -> crash -> native
crash -> report: "saved context"
