vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down

S: "Session.objects" { class: box }
O: "Objects.sheets = 17" { class: box }
H: "Sheet" { class: focus }
Arrays: "" {
  style: { fill: "transparent"; stroke: "transparent" }
  grid-columns: 1
  grid-gap: 12
  C: "coords = 3\n48 B per segment" { class: box }
  K: "colors = 4 · widths = 5\n4 B per segment" { class: box }
  I: "source_ids = 15\n4 B per segment, last" { class: box }
}

S -> O { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
O -> H { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
H -> Arrays.C { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
