vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
document: "Shared CPU document: geometry, camera, history"
old: "Retired drawing runtime"
new: "Replacement drawing runtime"
gpu: "New GPU resources"
document -> old: temporary borrow
document -> new: retained owner
new -> gpu
