vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down

canvas: "canvas" { class: box }
surface: "surface" { class: box }
adapter: "adapter" { class: box }
device: "device + queue" { class: box }
pipeline: "pipeline" { class: box }
encoder: "encoder" { class: box }
tex: "surface texture" { class: box }
screen: "screen" { class: box }

canvas -> surface: "create_surface" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
surface -> adapter: "request_adapter(compatible_surface)" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
adapter -> device: "request_device" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
device -> pipeline: "create_render_pipeline" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
device -> encoder: "create_command_encoder" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
encoder -> tex: "begin_render_pass(clear, draw 3)" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
tex -> screen: "queue.submit · present" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
