vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Immutable source vertices and colours"
n1: "CPU allocation identity: weak cache lookup"
n2: "Upgrade live owner or upload current source"
n3: "Drop old rows and prune expired entries"
n4: "Shader chooses per-object colour"
n5: "Draw and verify independent settings"
n0 -> n1 -> n2 -> n3 -> n4 -> n5
