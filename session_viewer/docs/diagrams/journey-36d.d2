vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Checked row identity and saved GUID"
b: "Original kernel coordinates and row model"
c: "World points in double precision"
d: "Final display conversion and connected spans"
e: "History shares sources and display caches"
f: "Close drops rows, capacity and all document owners"
a -> b
b -> c
c -> d
b -> e
e -> f
