vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down

F: "fixture.rs\nObjectRow + RenderVertex" { class: box }
U: "Upload\nobj rows · arena rows" { class: box }
T: "InstanceTable\ngroup 2" { class: box }
A: "ArenaLane\nGrowBufs" { class: box }
FR: "FrameUniforms\ngroups 0, 1" { class: box }
P: "triangle.wgsl\nvs_main · fs_main" { class: box }
TG: "Targets\ncolor + Depth32Float" { class: box }

F -> U { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
U -> T: "Gpu::set_scene" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
U -> A: "Gpu::set_scene" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
FR -> P { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
T -> P { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
A -> P { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
P -> TG { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
