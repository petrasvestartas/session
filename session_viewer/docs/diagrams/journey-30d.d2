vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Open / Open Replace starts a ticket + mode"
n1: "Selected task captures mode and pending ticket"
n2: "Current completion delivers checked operation + bytes"
n3: "Import or atomic Replace; report actual result"
n0 -> n1 -> n2 -> n3
