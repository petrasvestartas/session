vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Original curve Rc and control index"
b: "Checked dimension, stride and range"
c: "Original homogeneous coordinate and weight"
d: "Exact Euclidean control position"
e: "Finite six-pixel display marker"
f: "Same curve identity and source lifetime"
a -> b
b -> c
c -> d
d -> e
a -> f
