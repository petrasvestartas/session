vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Typed Save reads current source snapshot"
n1: "Uint8Array → Blob → temporary object URL"
n2: "Hidden anchor starts download; timer releases URL"
n3: "Open downloaded file; validate and restore local sources + placement"
n0 -> n1 -> n2 -> n3
