vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: right

S: "face sign" { class: box }
A: "ArenaRows" { class: focus }
C: "chain" { class: box }
P: "pipes" { class: focus }
N: "no chain" { class: box }
R: "sampled ribbon" { class: box }

S -> A: "flip normals + winding" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
C -> P: "walk_brep_edges" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
N -> R: "push_curve_ribbon" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
