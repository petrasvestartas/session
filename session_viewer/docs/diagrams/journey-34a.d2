vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Actual GPU error or device loss"
n1: "Record the first failure immediately"
n2: "Input guard: no panel updates or GPU work"
n3: "Next microtask: matching device owner?"
n4: "Take runtime, release borrow, dispose listeners and requests"
n5: "Visible failure; normal reload creates a fresh viewer"
n0 -> n1 -> n2
n1 -> n3 -> n4 -> n5
