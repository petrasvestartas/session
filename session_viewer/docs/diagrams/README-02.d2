vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down

Gpu: "engine/gpu · Gpu" { class: box }
Lanes: "engine/gpu" {
  style: { fill: "#f1f1f4"; stroke: "#f1f1f4"; border-radius: 6; font-color: "#455b6b"; font-size: 13 }
  grid-columns: 2
  grid-gap: 14
  Faces: "arena · faces\ntriangle.wgsl" { class: box }
  Ink: "segments\nribbon.wgsl\nink_visibility.wgsl" { class: box }
  Points: "glyphs · cloud · splat" { class: box }
  Text: "text · text_plate\ntext_plane" { class: box }
  Outline: "surface_outline" { class: box }
  Tiles: "triangle_tiles\nfinite visibility" { class: box }
  Pick: "pick · IDs → Scene" { class: box }
}

Gpu -> Lanes.Faces { style: { stroke: "#0b1957"; stroke-width: 2 } }
Gpu -> Lanes.Text { style: { stroke: "#0b1957"; stroke-width: 2 } }
Gpu -> Lanes.Tiles { style: { stroke: "#0b1957"; stroke-width: 2 } }
