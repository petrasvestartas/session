vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down

sel: "selected parent" { class: box }
ctl: "Controls { points, links } from the source geometry" { class: box }
lanes: "controls glyph lane · control_net segment lane" { class: box }
pick: "Pick { row = parent, sub = control index }" { class: box }
id: "ControlId::Vertex / Curve / Surface / Point" { class: box }
yellow: "selected marker turns yellow" { class: box }

sel -> ctl: "F10" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
ctl -> lanes: "upload_controls" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
lanes -> pick: "click → ID pass (PickMode::Controls)" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
pick -> id { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
id -> yellow { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
