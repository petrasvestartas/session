vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down
rust: "Rust record\nfields at known byte offsets" { class: box }
buffer: "GPU buffer\nrows of 96 bytes" { class: box }
binding: "Bind group\ngroup 2 · binding 0" { class: focus }
shader: "WGSL array of Instance\nreads the same field offsets" { class: box }
rust -> buffer: "upload bytes" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
buffer -> binding: "bind this storage" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
binding -> shader: "numbered resource slot" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
