vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Invalid clocks or timestamp parse"
n1: "Healthy or closed outcome"
n2: "Failure before start or incorrect time order"
n3: "No candidate score; original evidence unchanged"
n0 -> n3
n1 -> n3
n2 -> n3
