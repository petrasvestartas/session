vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Flight owns keys + optional Intent"
n1: "Fetch owns URL strings + abort signal"
n2: "Current ticket takes keys + Intent"
n3: "Reply → synchronous browser mailbox"
n4: "Hydration; automatic replay follows next"
n0 -> n1 -> n2 -> n3 -> n4
