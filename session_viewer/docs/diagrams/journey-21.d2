vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box: { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 16; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 16; font-color: "#111111" } }
}
direction: down
idle: "Idle\nNo pointer owns a gesture" {class: box}
press: "Press\nRemember ID, button and position" {class: focus}
move: "Right move\nDelta becomes an Orbit action" {class: box}
release: "Release\nA short left press becomes Pick" {class: box}
cancel: "Cancel / lost focus\nNo pick, forget the pointer" {class: box}
done: "Idle again\nMovement alone does nothing" {class: focus}
idle -> press
press -> move -> release -> done
press -> cancel -> done
