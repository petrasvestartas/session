vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
direction: right
n0: "CommandLine state" { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n1: "History + field + completion" { style: { fill: "#fa9ebc"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n2: "egui shapes and font atlas" { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n3: "Existing GPU paints the dock" { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n0 -> n1
n1 -> n2
n2 -> n3
