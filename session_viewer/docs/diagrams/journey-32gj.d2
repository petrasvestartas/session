vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Original source coordinate: f64 sentinel"
n1: "Derived GPU float differs; drawing is insufficient proof"
n2: "Unload kernel; restore original source bytes"
n3: "Save actual editable download"
n4: "Read vertex map: compare original doubles"
n5: "Verify placement, history and URL cleanup separately"
n0 -> n1 -> n2 -> n3 -> n4 -> n5
