vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down

R: "fixture: CylinderSegment rows" { class: box }
S: "SegRows\npipes · ribbons" { class: box }
G3: "group 3\nsegments · source_edges · edge_selection" { class: box }
V: "ribbon.wgsl vs_main\n6 verts per segment, no vertex buffer" { class: box }
Q: "screen-space quad\n+ FILTER_REACH" { class: box }
FS: "fs_main\nband_area coverage · ink_visible" { class: box }
D: "physical depth\ngroup 2 bindings 2, 3" { class: box }

R -> S { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
S -> G3: "SegmentLane::append" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
G3 -> V { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
V -> Q { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
Q -> FS { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
D -> FS { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
