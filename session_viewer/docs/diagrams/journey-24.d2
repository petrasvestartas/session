vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box: { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 16; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 16; font-color: "#111111" } }
}
direction: down
measure: "Scene measures all displayed vertices\nSmallest and largest x / y / z" {class: box}
sphere: "Centre = midpoint of box\nRadius = half the box diagonal" {class: focus}
angle: "Choose the smaller half-angle\nTall window: horizontal · Wide window: vertical" {class: box}
fit: "Camera aims at centre\nDistance = 1.1 × radius / sin(half-angle)" {class: focus}
clip: "Radius scales zoom limits and clipping\nOrientation, meshes and history stay unchanged" {class: box}
measure -> sphere
sphere -> fit
angle -> fit
fit -> clip
