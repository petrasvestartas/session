vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Original nx / ny / nz attributes"
b: "Kernel display normal extraction"
c: "Checked finite normalization"
d: "Nonzero smooth direction or explicit flat zero"
e: "Separate retained normal stream"
f: "Original attributes remain unchanged"
a -> b
b -> c
c -> d
d -> e
a -> f
