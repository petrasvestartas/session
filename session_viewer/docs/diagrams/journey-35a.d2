vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
source: "Exact shared kernel line"
a: "Active row: ID and placement"
b: "Undo row: same source, previous placement"
c: "Placed world bounds"
d: "Close releases active and historical owners"
source -> a
source -> b
a -> c
a -> d
b -> d
