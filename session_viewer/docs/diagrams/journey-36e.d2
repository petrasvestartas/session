vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Example Polyline / Example Arrow"
b: "Prepare original Polyline or headed Line"
c: "One undoable connected row insertion"
d: "Actual join and head pixels"
e: "Camera changes reuse instance vertices"
f: "Close clears history, source owners and GPU resources"
a -> b
b -> c
c -> d
e -> d
c -> f
