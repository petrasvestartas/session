vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Device lifetime: one Fault allocation"
n1: "Arc clones: same owner"
n2: "Mutex: check and store together"
n3: "First reason retained; later errors ignored"
n4: "Replacement device: a new allocation"
n0 -> n1 -> n2 -> n3
n4 -> n0: "independent owner"
