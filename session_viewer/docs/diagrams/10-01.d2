vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down

A: "TextLabel\nstring · size · line height" { class: box }
B: "shaped Buffer\nglyph IDs · advances · clusters" { class: box }
C: "TextDocument\nruns cached by id" { class: box }
D: "browser reference page" { class: box }
E: "placement · raster · GPU" { class: box }

A -> B: "Cosmic Text · Noto fonts" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
B -> C { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
C -> D: "diagnostics()" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
C -> E { style: { stroke: "#8a8fb0"; stroke-width: 2; stroke-dash: 4; font-size: 13; font-color: "#455b6b" } }
