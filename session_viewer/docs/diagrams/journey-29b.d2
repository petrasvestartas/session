vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Bytes: mesh IDs + stored matrices"
n1: "Validate IDs, uniqueness, length, finiteness and affine row"
n2: "Prepared local source + derived display + model"
n3: "Insert model once; source vertices stay local"
n0 -> n1 -> n2 -> n3
