vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down
click: "Browser viewport coordinates" {class: box}
canvas: "Canvas rectangle → −1…+1" {class: box}
camera: "Undo scale, rotation and pan" {class: focus}
triangles: "Covered triangles → nearest depth" {class: box}
identity: "ObjectId → selection" {class: focus}
click -> canvas -> camera -> triangles -> identity
