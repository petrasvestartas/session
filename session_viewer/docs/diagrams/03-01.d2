vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down

src: "SourceObject\nguid · revision" { class: box }
inst: "Instance\nmodel · color · flags" { class: box }
buf: "instances[]" { class: box }
vs: "vs_main(instance_index)" { class: box }
draw: "draw(0..3, row..row+1)" { class: box }
px: "two tinted, placed triangles" { class: box }

src -> inst: "row" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
inst -> buf: "bytemuck · STORAGE buffer" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
buf -> vs: "@group(0) @binding(1)" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
draw -> vs { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
vs -> px { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
