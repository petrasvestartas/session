vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Original ObjectId + offset"
n1: "Look up that row now"
n2: "Compose shift with CURRENT model"
n3: "One History::try_edit transaction"
n4: "Keep later selection + camera"
n0 -> n1 -> n2 -> n3 -> n4
