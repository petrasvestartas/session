vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}

direction: down

I: "Browser: winit events" { class: box }
C: "CPU: egui context + widget state\ncommand and panel actions" { class: focus }
B: "GPU: egui buffers + font texture\nreuse until changed" { class: box }
P: "GPU: final egui render pass\nafter scene and gumball" { class: box }
F: "Surface: white UI, black text\ntexture frees processed between frames" { class: box }
I -> C: "input" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
C -> B: "tessellate + upload" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
B -> P: "bind + draw" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
P -> F: "submit + present" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
