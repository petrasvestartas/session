vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box: { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 16; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 16; font-color: "#111111" } }
}
direction: down
input: "Browser keys and pointer" {class: box}
dock: "Real command dock\ntext, completion, history" {class: focus}
command: "Submitted text: Background" {class: box}
state: "Application changes one value" {class: box}
frame: "wgpu draws geometry\negui draws the dock above it" {class: box}
input -> dock
dock -> command
command -> state
state -> frame
