vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Selected file → bytes or read error"
n1: "Main event closure owns editor and command history"
n2: "Successful commit OR retained old scene + error"
n3: "Report the actual outcome in the command dock"
n0 -> n1 -> n2 -> n3
