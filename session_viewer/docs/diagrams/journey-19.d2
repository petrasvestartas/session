vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box: { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 16; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 16; font-color: "#111111" } }
}
direction: down
command: "Typed command" {class: box}
pointer: "Canvas picking" {class: box}
action: "Action\nWhat the user requested" {class: focus}
editor: "Editor\nScene · selection · history · view" {class: focus}
scene: "Change::Scene\nUpload, then redraw" {class: box}
view: "Change::View\nRedraw" {class: box}
command -> action
pointer -> action: "same request"
action -> editor
editor -> scene
editor -> view
