vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Original smooth direction or derivative face"
b: "Actual front-facing restores sharp orientation"
c: "Finite world-normal direction"
d: "Diagnostic RGB from minus one to plus one"
e: "View setting independent of document history"
f: "Shared geometry buffers remain unchanged"
a -> b
b -> c
c -> d
e -> d
f -> d
