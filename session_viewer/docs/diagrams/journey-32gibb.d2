vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Captured Intent"
n1: "Move or Delete → explicit-target editor helper"
n2: "Save → original source snapshot"
n3: "Reply: changed scene OR saved bytes"
n4: "Future ticket owner accepts one reply"
n0 -> n1 -> n3
n0 -> n2 -> n3
n3 -> n4
