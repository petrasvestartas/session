vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Selected file owns a ReadGate ticket"
n1: "Queued size check and promise"
n2: "finish consumes only current ticket; cancel revokes"
n3: "Accepted outcome gets an Open history entry"
n0 -> n1 -> n2 -> n3
