vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down
browser: "Browser coordinator" {class: box}
scene: "Scene owns CPU meshes" {class: focus}
mesh: "Mesh: validated vertices and indices" {class: box}
gpu: "GpuMesh: derived buffers" {class: box}
renderer: "Renderer draws the uploaded list" {class: focus}
browser -> scene: "change"
scene -> mesh: "owns"
mesh -> gpu: "upload"
gpu -> renderer: "draw"
browser -> renderer: "synchronize"
