vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box: { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 16; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 16; font-color: "#111111" } }
}
direction: down
n0: "Panel owns CommandLine" {class: box}
n1: "Default creates its empty state" {class: box}
n2: "Field borrows text and status" {class: focus}
n3: "Changed hint is drawn over the scene" {class: box}
n0 -> n1
n1 -> n2
n2 -> n3
