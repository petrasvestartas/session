vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Clip span before dividing by w"
b: "Shared bounded endpoint cross-sections"
c: "Physical-pixel offset scaled back by clip w"
d: "Adjacent triangles meet along a shared edge"
e: "Analytic screen-space coverage"
a -> b
b -> c
c -> d
d -> e
