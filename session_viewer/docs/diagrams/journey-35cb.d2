vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Document line rows and exact sources"
b: "Placed display records"
c: "Shared instance lane"
d: "Camera matrix, physical viewport and effective density"
e: "Mesh and stroke draw in the same depth pass"
f: "Close releases source/history owners and instance buffers"
a -> b
b -> c
c -> e
d -> e
a -> f
c -> f
