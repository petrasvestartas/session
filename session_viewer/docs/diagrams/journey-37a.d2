vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Project original point centre"
b: "Reject a centre outside the depth range"
c: "CSS diameter times effective density"
d: "Offset a billboard by clip w"
e: "Circular fragment distance and alpha coverage"
a -> b
b -> c
c -> d
d -> e
