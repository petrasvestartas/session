vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: right
button: "Typed Background + Enter" {class: box}
state: "Background state" {class: focus}
renderer: "Renderer reads it" {class: box}
pixels: "New picture" {class: box}
button -> state
state -> renderer
renderer -> pixels
