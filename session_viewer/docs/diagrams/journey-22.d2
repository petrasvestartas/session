vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box: { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 16; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 16; font-color: "#111111" } }
}
direction: down
wheel: "Wheel over canvas\nPixels / lines / pages" {class: box}
key: "Typed text anywhere\nFirst letter opens the dock" {class: box}
units: "navigation::wheel\nNormalize → zoom factor" {class: focus}
shortcut: "Command dock owns text\nEnter submits the named command" {class: focus}
action: "Existing Action\nZoom / Pan / Delete / Undo …" {class: box}
editor: "Editor owns the change\nCamera OR document history" {class: focus}
frame: "Renderer draws the result" {class: box}
wheel -> units -> action
key -> shortcut -> action
action -> editor -> frame
