vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down
target: "Target stays fixed" {shape: circle; class: focus}
orientation: "Orientation\nright / forward / up" {class: box}
eye: "eye = target − forward × distance" {class: focus}
view: "View matrix and pick ray" {class: box}
target -> eye
orientation -> eye
orientation -> view: "up"
eye -> view
