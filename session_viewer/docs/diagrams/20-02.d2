vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down

T: "Tombstone" { class: focus }
Parts: "" {
  style: { fill: "transparent"; stroke: "transparent" }
  grid-columns: 1
  grid-gap: 12
  O: "obj clone · collection · obj_index" { class: box }
  X: "xform · parent_guid · index" { class: box }
  N: "subtree node · attribute · edges" { class: box }
}

T -> Parts.O { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
