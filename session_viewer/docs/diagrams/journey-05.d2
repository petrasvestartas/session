vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down
cpu: "Rust: six pairs of f32" {class: box}
bytes: "48 uploaded bytes" {class: box}
layout: "8 bytes per corner\nlocation 0 = x, y" {class: focus}
shader: "Vertex shader receives a pair" {class: box}
image: "Six vertices → two triangles" {class: box}
cpu -> bytes -> layout -> shader -> image
