vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "begin issues a unique pending ticket"
n1: "New begin supersedes; cancel revokes"
n2: "finish compares without consuming another ticket"
n3: "Matching completion consumes its ticket once"
n0 -> n1 -> n2 -> n3
