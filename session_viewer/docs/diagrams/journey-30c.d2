vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Decode and prepare every replacement source"
n1: "History transaction replaces rows; counter survives"
n2: "Repair old selection; camera stays unchanged"
n3: "Undo restores old owners; Redo restores replacement IDs"
n0 -> n1 -> n2 -> n3
