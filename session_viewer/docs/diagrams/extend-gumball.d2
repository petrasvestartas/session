vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}

direction: down

M: "CPU: fixed cylindrical mesh\n18,576 vertices" { class: box }
B: "GPU: vertex buffer + 96-byte uniform\nreused across frames" { class: box }
S: "WGSL: transform positions\nflat colors; no lighting" { class: focus }
T: "GPU: cropped 4× MSAA tile\nresolve at 2× screen resolution" { class: box }
F: "WGSL: composite over scene\ndeselect destroys tile" { class: box }
M -> B: "upload once" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
B -> S: "draw" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
S -> T: "rasterize" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
T -> F: "resolve + sample" { style: { stroke: "#0b1957"; stroke-width: 2; font-size: 13; font-color: "#455b6b" } }
