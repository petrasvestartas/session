vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Keyboard press"
b: "Text field owns typed content"
c: "Canvas F or available history key"
d: "Echo its existing command"
e: "Apply the existing editor action"
a -> b: editing
a -> c: shortcut
c -> d
d -> e
