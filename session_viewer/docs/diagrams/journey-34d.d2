vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "First scene presented: record ready milestone"
n1: "Typed Diagnostic Report"
n2: "Independent metadata snapshot, released slot borrow"
n3: "Named JSON download, delayed Blob URL release"
n4: "Matching failure: dispose GPU, retain fatal evidence"
n0 -> n1 -> n2 -> n3
n4 -> n2: "one automatic attempt"
