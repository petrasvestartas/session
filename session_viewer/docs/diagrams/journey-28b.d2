vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Generated kernel triangle / box or imported mesh"
n1: "One PreparedMesh insertion boundary"
n2: "Object: stable ID + source + placement"
n3: "Drawing cache derived from source geometry"
n0 -> n1 -> n2 -> n3
