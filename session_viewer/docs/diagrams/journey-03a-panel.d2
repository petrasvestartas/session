vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box: { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 16; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 16; font-color: "#111111" } }
}
direction: down
n0: "Panel owns the command String" {class: box}
n1: "Choose panel rectangle and spacing" {class: box}
n2: "Field borrows the String for this draw" {class: focus}
n3: "Shared painter draws the field" {class: box}
n0 -> n1
n1 -> n2
n2 -> n3
