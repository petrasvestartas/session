vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down
past: "Undo stack\nprevious scene snapshots" {class: box}
scene: "Current document\nshared immutable meshes" {class: focus}
future: "Redo stack\nstates we just left" {class: box}
view: "Camera and background\nstay outside history" {class: box}
past -> scene: "undo"
scene -> future: "save current"
future -> scene: "redo"
scene -> past: "save current"
