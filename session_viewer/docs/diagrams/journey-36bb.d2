vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
a: "Original Start / End / Both flags"
b: "Suppress a near-clipped tip"
c: "Head length is limited by visible span"
d: "Body ends at head base"
e: "Triangular head coverage; no duplicate interior"
a -> b
b -> c
c -> d
d -> e
