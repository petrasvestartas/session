vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
classes: {
  box:   { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15; font-color: "#111111" } }
  focus: { style: { fill: "#fa9ebc"; stroke: "#fa9ebc"; border-radius: 6; font-size: 15; font-color: "#111111" } }
}
direction: down
state: "Scale and offset\nfour f32 values" {class: focus}
uniform: "Uniform buffer\n16 bytes" {class: box}
group: "Group 0, binding 0" {class: box}
positions: "Unchanged vertex buffer" {class: box}
shader: "position × scale + offset" {class: focus}
state -> uniform -> group -> shader
positions -> shader
