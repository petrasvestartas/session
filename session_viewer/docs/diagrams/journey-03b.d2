vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
direction: right
n0: "Browser owns Panel" { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n1: "Panel owns CommandLine" { style: { fill: "#fa9ebc"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n2: "CommandLine keeps text and history" { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n0 -> n1
n1 -> n2
