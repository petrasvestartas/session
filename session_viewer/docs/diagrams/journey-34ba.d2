vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
n0: "Observation: finite time and bounded text"
n1: "Recent queue: keep the last 24 events"
n2: "First fatal: retain one independent copy"
n3: "Later events rotate; first reason stays"
n4: "Later milestone cannot clear failed outcome"
n0 -> n1 -> n3
n0 -> n2 -> n3 -> n4
