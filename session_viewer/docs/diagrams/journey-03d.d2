vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
direction: right
n0: "Browser keyboard event" { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n1: "Panel translates once" { style: { fill: "#fa9ebc"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n2: "Dock submits a line" { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n3: "Application answers" { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n4: "Empty-input layout draws the answer" { style: { fill: "#e9e9ec"; stroke: "#e9e9ec"; border-radius: 6; font-size: 15 } }
n0 -> n1
n1 -> n2
n2 -> n3
n3 -> n4
