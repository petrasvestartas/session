vars: { d2-config: { layout-engine: elk; pad: 20; theme-id: 0 } }
style: { fill: "#ffffff" }
direction: down
prior: "Select earlier evidence before current write"
current: "Stable tab; fresh run key; ready/fatal writes"
gpu: "GPU lifetime stops; metadata store remains"
reload: "Healthy reload caches selected prior metadata"
command: "Dock notice and Diagnostic Report Previous"
prior -> current -> gpu -> reload -> command
