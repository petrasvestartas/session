-### 1. `src/command_dock/mod.rs`
+### 1. `src/shortcuts.rs`
+
+Route keyboard shortcuts through the actual egui focus owner before exercising layer editing. Append this helper after `key`; popup controls and nonempty focused fields retain their keyboard input.
+
+```rust
+pub fn context_key(
+    context: &egui::Context,
+    command_text: &str,
+    text: &str,
+    command: bool,
+    shift: bool,
+    alt: bool,
+    composing: bool,
+) -> Option<Shortcut> {
+    if egui::Popup::is_any_open(context) {
+        return None;
+    }
+    let empty_command = context.memory(|memory| memory.focused())
+        == Some(egui::Id::new("command-input"))
+        && command_text.is_empty();
+    key(
+        text,
+        command,
+        shift,
+        alt,
+        composing,
+        context.egui_wants_keyboard_input(),
+        empty_command,
+    )
+}
+```
+
