  {
    "test_name": "Runtime Modification",
    "passed": true,
    "time_ms": 0.0,
    "line": 56,
    "code": "        // Get current default values\n        let original_absolute = TOLERANCE.absolute();\n        let original_relative = TOLERANCE.relative();\n\n        // Modify tolerance values at runtime\n        TOLERANCE.set_absolute(1e-12);\n        TOLERANCE.set_relative(1e-12);\n\n        // Test with new tolerance - 1e-11 difference now fails is_close\n        let close_with_tight = TOLERANCE.is_close(1.0, 1.0 + 1e-11);\n\n        // Reset to defaults\n        TOLERANCE.reset();\n\n        // Same test now passes with default tolerance\n        let close_with_default = TOLERANCE.is_close(1.0, 1.0 + 1e-11);",
    "checks": [
      {
        "line": 60,
        "code_line": "original_absolute == 1e-9",
        "passed": true
      },
      {
        "line": 61,
        "code_line": "original_relative == 1e-6",
        "passed": true
      },
      {
        "line": 66,
        "code_line": "TOLERANCE.absolute() == 1e-12",
        "passed": true
      },
      {
        "line": 67,
        "code_line": "TOLERANCE.relative() == 1e-12",
        "passed": true
      },
      {
        "line": 71,
        "code_line": "close_with_tight == false",
        "passed": true
      },
      {
        "line": 75,
        "code_line": "TOLERANCE.absolute() == 1e-9",
        "passed": true
      },
      {
        "line": 76,
        "code_line": "TOLERANCE.relative() == 1e-6",
        "passed": true
      },
      {
        "line": 80,
        "code_line": "close_with_default == true",
        "passed": true
      }
    ],
    "failures": []
  },
