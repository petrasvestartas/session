  {
    "group": "Tolerance",
    "test_name": "Runtime Modification",
    "passed": true,
    "time_ms": 0.001,
    "line": 73,
    "code": "        // uncomment #include \"tolerance.h\"\n        // Get current default values\n        double original_absolute = TOLERANCE.absolute();\n        double original_relative = TOLERANCE.relative();\n\n\n        // Modify tolerance values at runtime\n        TOLERANCE.set_absolute(1e-12);\n        TOLERANCE.set_relative(1e-12);\n\n        // Test with new tolerance - 1e-11 difference now fails is_close\n        bool close_with_tight = TOLERANCE.is_close(1.0, 1.0 + 1e-11);\n\n        // Reset to defaults\n        TOLERANCE.reset();\n\n        // Same test now passes with default tolerance\n        bool close_with_default = TOLERANCE.is_close(1.0, 1.0 + 1e-11);",
    "checks": [
      {
        "line": 79,
        "code_line": "original_absolute == 1e-9",
        "passed": true
      },
      {
        "line": 80,
        "code_line": "original_relative == 1e-6",
        "passed": true
      },
      {
        "line": 85,
        "code_line": "TOLERANCE.absolute() == 1e-12",
        "passed": true
      },
      {
        "line": 86,
        "code_line": "TOLERANCE.relative() == 1e-12",
        "passed": true
      },
      {
        "line": 90,
        "code_line": "!close_with_tight",
        "passed": true
      },
      {
        "line": 94,
        "code_line": "TOLERANCE.absolute() == 1e-9",
        "passed": true
      },
      {
        "line": 95,
        "code_line": "TOLERANCE.relative() == 1e-6",
        "passed": true
      },
      {
        "line": 99,
        "code_line": "close_with_default",
        "passed": true
      }
    ],
    "failures": []
  },
